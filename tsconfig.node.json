{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // The release script and its test live here rather than in tsconfig.app.json:
  // they are Node code, not browser code, and need `types: ["node"]`. Including
  // them is what makes `tsc -b` (and so CI's `pnpm build`) check them —
  // `allowJs` alone would only make the `// @ts-check`ed .mjs script visible,
  // leaving its annotations as editor-only decoration.
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/bump-version.mjs",
    "scripts/bump-version.test.ts"
  ]
}
